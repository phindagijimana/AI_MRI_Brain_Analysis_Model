    submit_models.set_defaults(func=cmd_submit_models)

    # Single-task shortcuts.
    for name, help_text in [
        ("age", "Run brain-age task"),
        ("brainage", "Run brain-age task"),
        ("idh", "Run IDH task"),
        ("mci", "Run MCI task"),
