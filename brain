#!/usr/bin/env python3
"""
Top-level CLI wrapper for Brain_Cal pipeline.

Examples:
  ./brain run --input /data/sub-01.nii.gz --output-dir outputs --mock
  ./brain submit sub-01 --input /data/sub-01.nii.gz --output-dir outputs --mock --dry-run
  ./brain submit cohort --input-dir /data/nifti --output-dir outputs --mock --dry-run
  ./brain submit array --input-dir /data/nifti --output-dir outputs --mock --dry-run
  ./brain age --input /data/sub-01_T1w.nii.gz --output-dir outputs
  ./brain run-tasks segmentation brainage --input-dir /data --output-dir outputs
  ./brain segment --input-dir Data_Brain --output-dir outputs_real_seg
  ./brain submit-seg cohort --input-dir Data_Brain/sub-1 --output-dir outputs_real_slurm_sub1
  ./brain status
"""

