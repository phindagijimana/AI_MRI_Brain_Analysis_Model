def _append_optional(args_list: List[str], flag: str, value: object | None) -> None:
    if value is not None:
        args_list.extend([flag, str(value)])


def cmd_run(args: argparse.Namespace) -> int:
    cmd: List[str] = [sys.executable, str(RUN_SCRIPT)]
    if args.input is not None:
        cmd += ["--input", str(args.input)]
    if args.input_dir is not None:
        cmd += ["--input-dir", str(args.input_dir)]
    cmd += ["--output-dir", str(args.output_dir)]

    _append_optional(cmd, "--model-path", args.model_path)
    _append_optional(cmd, "--model-meta", args.model_meta)
    cmd += ["--task", args.task, "--sequence", args.sequence]
    cmd += ["--target-spacing", str(args.target_spacing)]
    cmd += ["--target-shape", str(args.target_shape[0]), str(args.target_shape[1]), str(args.target_shape[2])]
    cmd += ["--device", args.device, "--seed", str(args.seed)]

    if args.save_preprocessed:
        cmd.append("--save-preprocessed")
    if args.mock:
        cmd.append("--mock")
    if args.fail_fast:
        cmd.append("--fail-fast")
    if args.verbose:
        cmd.append("--verbose")

    return subprocess.run(cmd, check=False).returncode


def cmd_submit(args: argparse.Namespace) -> int:
    # First positional argument maps to mode:
    #   sub-01 => single
    #   cohort => cohort
    #   array  => array
    subject_or_mode = args.subject_or_mode
    if subject_or_mode in {"cohort", "array"}:
        mode = subject_or_mode
    else:
        mode = "single"

    cmd: List[str] = [sys.executable, str(SUBMIT_SCRIPT), "--mode", mode, "--output-dir", str(args.output_dir)]

    if mode == "single":
        if args.input is None:
            raise SystemExit("submit single mode requires --input")
        cmd += ["--input", str(args.input)]
    else:
        if args.input_dir is None:
            raise SystemExit(f"submit {mode} mode requires --input-dir")
        cmd += ["--input-dir", str(args.input_dir)]

    _append_optional(cmd, "--model-path", args.model_path)
    _append_optional(cmd, "--model-meta", args.model_meta)
    cmd += ["--task", args.task, "--sequence", args.sequence]
    cmd += ["--target-spacing", str(args.target_spacing)]
    cmd += ["--target-shape", str(args.target_shape[0]), str(args.target_shape[1]), str(args.target_shape[2])]
    cmd += ["--device", args.device, "--seed", str(args.seed)]

    # SLURM options
    cmd += ["--job-name", args.job_name, "--time", args.time, "--cpus", str(args.cpus), "--mem", args.mem]
    _append_optional(cmd, "--partition", args.partition)
    _append_optional(cmd, "--account", args.account)
    _append_optional(cmd, "--qos", args.qos)
    _append_optional(cmd, "--gres", args.gres)
    _append_optional(cmd, "--constraint", args.constraint)
    _append_optional(cmd, "--chdir", args.chdir)
    _append_optional(cmd, "--logs-dir", args.logs_dir)
    if mode == "array":
        cmd += ["--max-parallel", str(args.max_parallel)]

    if args.save_preprocessed:
        cmd.append("--save-preprocessed")
    if args.mock:
        cmd.append("--mock")
    if args.fail_fast:
        cmd.append("--fail-fast")
    if args.verbose:
        cmd.append("--verbose")
    if args.dry_run:
        cmd.append("--dry-run")

    return subprocess.run(cmd, check=False).returncode


def _discover_niftis(input_dir: Path) -> List[Path]:
    return sorted(list(input_dir.rglob("*.nii")) + list(input_dir.rglob("*.nii.gz")))


def _shell_join(parts: List[str]) -> str:
    return " ".join(shlex.quote(p) for p in parts)


def _shell_join_allow_vars(parts: List[str]) -> str:
    """Shell-quote args but preserve simple shell vars like $f or "$f"."""
    return " ".join(p if p.startswith("$") or p.startswith('"$') else shlex.quote(p) for p in parts)


def _strip_nii_suffix(path: Path) -> str:
    name = path.name
    if name.endswith(".nii.gz"):
        return name[:-7]
    if name.endswith(".nii"):
        return name[:-4]
    return path.stem


def _is_t1_file(path: Path) -> bool:
    name = path.name.lower()
    stem = _strip_nii_suffix(path).lower()
    return (
        "_t1w" in stem
        or "_t1n" in stem
        or stem.endswith("_t1")
        or stem.endswith("-t1")
        or stem == "t1"
        or name.startswith("t1")
    )


def _discover_idh_pairs(input_dir: Path) -> List[Tuple[Path, Path]]:
    # Expected dual modalities for IDH task: *_t2f.nii.gz and *_t1ce.nii.gz
    t2f_map = {}
    t1ce_map = {}
    for p in _discover_niftis(input_dir):
        stem = _strip_nii_suffix(p).lower()
        if stem.endswith("_t2f"):
            base = stem[:-4]
            t2f_map[base] = p
        elif stem.endswith("_t1ce"):
            base = stem[:-5]
            t1ce_map[base] = p
    pairs: List[Tuple[Path, Path]] = []
    for base in sorted(set(t2f_map.keys()) & set(t1ce_map.keys())):
        pairs.append((t2f_map[base], t1ce_map[base]))
    return pairs


def _find_idh_pair_for_single(input_path: Path) -> Tuple[Path, Path] | None:
    stem = _strip_nii_suffix(input_path).lower()
    parent = input_path.parent
    if stem.endswith("_t2f"):
        candidate = parent / f"{_strip_nii_suffix(input_path)[:-4]}_t1ce.nii.gz"
        if candidate.exists():
            return input_path, candidate
    if stem.endswith("_t1ce"):
        candidate = parent / f"{_strip_nii_suffix(input_path)[:-5]}_t2f.nii.gz"
        if candidate.exists():
            return candidate, input_path
    return None


def _maybe_write_segmentation_metrics(mask_path: Path, source_nifti: Path) -> None:
    if nib is None or np is None:
        return
    if not mask_path.exists():
        return
    try:
        arr = np.asanyarray(nib.load(str(mask_path)).dataobj)
        nonzero = int((arr > 0).sum())
        total = int(arr.size)
        metrics = {
            "task": "segmentation",
            "image_path": str(source_nifti),
            "mask_path": str(mask_path),
            "mask_shape": list(arr.shape),
            "mask_nonzero_voxels": nonzero,
            "mask_nonzero_fraction": float(nonzero / total) if total > 0 else 0.0,
        }
        metrics_path = mask_path.with_name(mask_path.name.replace(".nii.gz", "_metrics.json"))
        with open(metrics_path, "w", encoding="utf-8") as f:
            json.dump(metrics, f, indent=2)
    except Exception:
        # Metrics are best-effort; inference outputs should still be considered successful.
        return


def _collect_quantitative_outputs(output_dir: Path) -> None:
    rows = []
    for fp in sorted(output_dir.rglob("*_prediction.json")) + sorted(output_dir.rglob("*_metrics.json")):
        try:
            with open(fp, "r", encoding="utf-8") as f:
                payload = json.load(f)
        except Exception:
            continue
        if not isinstance(payload, dict):
            continue
        image_path = payload.get("image_path", "")
        image_name = Path(image_path).name if image_path else ""
        subject_id = image_name.split("_")[0] if image_name else ""
        age_months = payload.get("predicted_age_months", payload.get("predicted_age", ""))
        age_years = payload.get("predicted_age_years", "")
        if age_years == "" and isinstance(age_months, (int, float)):
            age_years = float(age_months) / 12.0
        row = {
            "subject_id": subject_id,
            "image_name": image_name,
            "task": fp.parent.name,
            "source_file": str(fp),
            "checkpoint_path": payload.get("checkpoint_path", ""),
            "predicted_age_months": age_months,
            "predicted_age_years": age_years,
            "pred_prob": payload.get("pred_prob", ""),
            "pred_label": payload.get("pred_label", ""),
            "pred_logit": payload.get("pred_logit", ""),
            "mask_nonzero_voxels": payload.get("mask_nonzero_voxels", ""),
            "mask_nonzero_fraction": payload.get("mask_nonzero_fraction", ""),
            "mask_shape": payload.get("mask_shape", ""),
        }
        rows.append(row)

    if not rows:
        return

    csv_path = output_dir / "quantitative_summary.csv"
    json_path = output_dir / "quantitative_summary.json"
    fields = [
        "subject_id",
        "image_name",
        "task",
        "source_file",
        "checkpoint_path",
        "predicted_age_months",
        "predicted_age_years",
        "pred_prob",
        "pred_label",
        "pred_logit",
        "mask_nonzero_voxels",
        "mask_nonzero_fraction",
        "mask_shape",
    ]
    with open(csv_path, "w", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fields)
        writer.writeheader()
        for row in rows:
            writer.writerow(row)
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(rows, f, indent=2)
    print(f"[summary] wrote {csv_path}")
    print(f"[summary] wrote {json_path}")


def cmd_segment(args: argparse.Namespace) -> int:
    if args.input is None and args.input_dir is None:
        raise SystemExit("segment requires one of --input or --input-dir")
    if args.input is not None and args.input_dir is not None:
        raise SystemExit("segment accepts only one of --input or --input-dir")

    if not args.checkpoint_path.exists():
        raise SystemExit(f"Missing checkpoint: {args.checkpoint_path}")
    if not args.simclr_checkpoint_path.exists():
        raise SystemExit(f"Missing backbone checkpoint: {args.simclr_checkpoint_path}")
    if not SEG_SCRIPT.exists():
        raise SystemExit(f"Missing segmentation script: {SEG_SCRIPT}")

    args.output_dir.mkdir(parents=True, exist_ok=True)
    inputs = [args.input] if args.input is not None else _discover_niftis(args.input_dir)
    if not inputs:
        raise SystemExit("No NIfTI files found for segment command.")

    failures = 0
    for f in inputs:
        cmd = [
            sys.executable,
            str(SEG_SCRIPT),
            "--checkpoint_path",
            str(args.checkpoint_path),
            "--simclr_checkpoint_path",
            str(args.simclr_checkpoint_path),
            "--image_path",
            str(f),
            "--output_dir",
            str(args.output_dir),
            "--gpu_device",
            args.gpu_device,
        ]
        rc = subprocess.run(cmd, check=False).returncode
        if rc != 0:
            failures += 1
            if args.fail_fast:
                return rc
    return 0 if failures == 0 else 2


def cmd_submit_seg(args: argparse.Namespace) -> int:
    mode = "single"
    if args.subject_or_mode in {"cohort"}:
        mode = "cohort"

    if not args.checkpoint_path.exists():
        raise SystemExit(f"Missing checkpoint: {args.checkpoint_path}")
    if not args.simclr_checkpoint_path.exists():
        raise SystemExit(f"Missing backbone checkpoint: {args.simclr_checkpoint_path}")
    if not SEG_SCRIPT.exists():
        raise SystemExit(f"Missing segmentation script: {SEG_SCRIPT}")

    if mode == "single":
        if args.input is None:
            raise SystemExit("submit-seg single mode requires --input")
        if not args.input.exists():
            raise SystemExit(f"Input file not found: {args.input}")
    else:
        if args.input_dir is None:
            raise SystemExit("submit-seg cohort mode requires --input-dir")
        if not args.input_dir.exists():
            raise SystemExit(f"Input dir not found: {args.input_dir}")

    args.logs_dir.mkdir(parents=True, exist_ok=True)
    args.output_dir.mkdir(parents=True, exist_ok=True)

    sbatch_cmd = [
        "sbatch",
        "--job-name",
        args.job_name,
        "--output",
        str(args.logs_dir / "%x_%j.out"),
        "--error",
        str(args.logs_dir / "%x_%j.err"),
        "--time",
        args.time,
        "--cpus-per-task",
        str(args.cpus),
        "--mem",
        args.mem,
    ]
    _append_optional(sbatch_cmd, "--partition", args.partition)
    _append_optional(sbatch_cmd, "--account", args.account)
    _append_optional(sbatch_cmd, "--qos", args.qos)
    _append_optional(sbatch_cmd, "--gres", args.gres)
    _append_optional(sbatch_cmd, "--constraint", args.constraint)
    _append_optional(sbatch_cmd, "--chdir", args.chdir)

    if mode == "single":
        inner = _shell_join(
            [
                sys.executable,
                str(SEG_SCRIPT),
                "--checkpoint_path",
                str(args.checkpoint_path),
                "--simclr_checkpoint_path",
                str(args.simclr_checkpoint_path),
                "--image_path",
                str(args.input),
                "--output_dir",
                str(args.output_dir),
                "--gpu_device",
                args.gpu_device,
            ]
        )
    else:
        loop_pattern = str(args.input_dir / "**" / "*.nii.gz")
        inner_cmd = _shell_join_allow_vars(
            [
                sys.executable,
                str(SEG_SCRIPT),
                "--checkpoint_path",
                str(args.checkpoint_path),
                "--simclr_checkpoint_path",
                str(args.simclr_checkpoint_path),
                "--image_path",
                '"$f"',
                "--output_dir",
                str(args.output_dir),
                "--gpu_device",
                args.gpu_device,
            ]
        )
        inner = (
            "shopt -s globstar nullglob; "
            f"for f in {loop_pattern}; do {inner_cmd}; done"
        )

    sbatch_cmd += ["--wrap", f"bash -lc {shlex.quote(inner)}"]
    print("$ " + _shell_join(sbatch_cmd))
    if args.dry_run:
        return 0
    return subprocess.run(sbatch_cmd, check=False).returncode


def cmd_status(args: argparse.Namespace) -> int:
    user = args.user if args.user else subprocess.check_output(["whoami"], text=True).strip()
    rc1 = subprocess.run(["squeue", "-u", user], check=False).returncode
    if args.job_ids:
        rc2 = subprocess.run(
            ["sacct", "-j", args.job_ids, "--format=JobID,JobName,State,Start,End", "-n"],
            check=False,
        ).returncode
        return 0 if rc1 == 0 and rc2 == 0 else 1
    return rc1


def cmd_logs(args: argparse.Namespace) -> int:
    if args.path is None:
        raise SystemExit("logs requires --path (file or directory)")
    if args.path.is_file():
        return subprocess.run(["sed", "-n", f"1,{args.lines}p", str(args.path)], check=False).returncode
    if args.path.is_dir():
        files = sorted(args.path.glob("*.log")) + sorted(args.path.glob("*.out")) + sorted(args.path.glob("*.err"))
        if not files:
            raise SystemExit(f"No log-like files found in {args.path}")
        newest = max(files, key=lambda p: p.stat().st_mtime)
        print(f"Showing: {newest}")
        return subprocess.run(["sed", "-n", f"1,{args.lines}p", str(newest)], check=False).returncode
    raise SystemExit(f"Path not found: {args.path}")


def _resolve_tasks(raw_tasks: str) -> List[str]:
    if raw_tasks.strip().lower() == "all":
        return list(ALL_TASKS)
    tasks = [t.strip().lower() for t in raw_tasks.split(",") if t.strip()]
    unknown = [t for t in tasks if t not in ALL_TASKS]
    if unknown:
        raise SystemExit(f"Unknown task(s): {unknown}. Allowed: {ALL_TASKS}")
    return tasks


def _task_ckpt(task: str, args: argparse.Namespace) -> Path:
    if args.checkpoint_map:
        # format: task=path,task2=path2
        pairs = {}
        for item in args.checkpoint_map.split(","):
            if "=" in item:
                k, v = item.split("=", 1)
                pairs[k.strip().lower()] = Path(v.strip())
        if task in pairs:
            return pairs[task]
    return DEFAULT_TASK_CKPTS[task]


def _validate_task_checkpoint(task: str, ckpt: Path) -> tuple[bool, str]:
    if not ckpt.exists():
        return False, f"missing checkpoint: {ckpt}"
    try:
        payload = torch.load(ckpt, map_location="cpu")
    except Exception as exc:
        return False, f"unable to load checkpoint ({type(exc).__name__}): {exc}"

    if task == "survival":
        # The current survival loader is ViT-based and expects ViT-style keys.
        state = None
        if isinstance(payload, dict):
            if isinstance(payload.get("state_dict"), dict):
                state = payload["state_dict"]
            elif isinstance(payload.get("model_state_dict"), dict):
                state = payload["model_state_dict"]
        if isinstance(state, dict):
            keys = list(state.keys())
            if any(k.startswith("backbone.backbone.conv1") for k in keys):
                return (
                    False,
                    "checkpoint appears ResNet-style (conv1 keys) and is not ViT-compatible. "
                    "Provide a ViT survival checkpoint (e.g., os.ckpt) via --checkpoint-map survival=/path/os.ckpt",
                )
    return True, "ok"


def _run_single_task(task: str, nifti: Path, output_dir: Path, args: argparse.Namespace) -> int:
    if task == "segmentation":
        seg_dir = output_dir / "segmentation"
        cmd = [
            sys.executable,
            str(SEG_SCRIPT),
            "--checkpoint_path",
            str(_task_ckpt("segmentation", args)),
            "--simclr_checkpoint_path",
            str(args.simclr_checkpoint_path),
            "--image_path",
            str(nifti),
            "--output_dir",
            str(seg_dir),
            "--gpu_device",
            args.gpu_device,
        ]
        rc = subprocess.run(cmd, check=False).returncode
        if rc == 0:
            mask_path = seg_dir / f"{_strip_nii_suffix(nifti)}_seg.nii.gz"
            _maybe_write_segmentation_metrics(mask_path, nifti)
        return rc

    script = TASK_SCRIPT[task]
    cmd = [
        sys.executable,
        str(script),
        "--nifti_path",
        str(nifti),
        "--checkpoint_path",
        str(_task_ckpt(task, args)),
        "--config_path",
        str(args.config_path),
        "--output_dir",
        str(output_dir / task),
        "--simclr_checkpoint_path",
        str(args.simclr_checkpoint_path),
        "--layer",
        str(args.layer),
        "--img_size",
        str(args.img_size[0]),
        str(args.img_size[1]),
        str(args.img_size[2]),
        "--patch_size",
        str(args.patch_size),
    ]
    return subprocess.run(cmd, check=False).returncode


def _run_idh_dual_task(nifti_t2f: Path, nifti_t1ce: Path, output_dir: Path, args: argparse.Namespace) -> int:
    cmd = [
        sys.executable,
        str(SAL_IDH),
        "--nifti_path",
        str(nifti_t2f),
        "--nifti_path2",
        str(nifti_t1ce),
        "--checkpoint_path",
        str(_task_ckpt("idh", args)),
        "--config_path",
        str(args.config_path),
        "--output_dir",
        str(output_dir / "idh"),
        "--simclr_checkpoint_path",
        str(args.simclr_checkpoint_path),
        "--layer",
        str(args.layer),
        "--img_size",
        str(args.img_size[0]),
        str(args.img_size[1]),
        str(args.img_size[2]),
        "--patch_size",
        str(args.patch_size),
    ]
    return subprocess.run(cmd, check=False).returncode


def cmd_models(args: argparse.Namespace) -> int:
    tasks = _resolve_tasks(args.tasks)
    if args.input is None and args.input_dir is None:
        raise SystemExit("models requires --input or --input-dir")
    if args.input is not None and args.input_dir is not None:
        raise SystemExit("models accepts only one of --input or --input-dir")
    all_inputs = [args.input] if args.input else _discover_niftis(args.input_dir)
    if not all_inputs:
        raise SystemExit("No NIfTI files found.")

    args.output_dir.mkdir(parents=True, exist_ok=True)
    failures = 0
    for task in tasks:
        ckpt = _task_ckpt(task, args)
        ok, reason = _validate_task_checkpoint(task, ckpt)
        if not ok:
            print(f"[skip] task={task} {reason}")
            failures += 1
            if args.fail_fast:
                return 2
            continue

        if task == "brainage":
            task_inputs = [p for p in all_inputs if _is_t1_file(p)]
            if not task_inputs:
                print("[skip] task=brainage no T1-like inputs found (expected filenames like *_T1w.nii.gz)")
                continue
            for nifti in task_inputs:
                rc = _run_single_task(task, nifti, args.output_dir, args)
                if rc != 0:
                    failures += 1
                    if args.fail_fast:
                        return rc
            continue

        if task == "idh":
            if args.input is not None:
                pair = _find_idh_pair_for_single(args.input)
                if pair is None:
                    print("[skip] task=idh single input requires paired *_t2f and *_t1ce files in the same folder")
                    continue
                rc = _run_idh_dual_task(pair[0], pair[1], args.output_dir, args)
                if rc != 0:
                    failures += 1
                    if args.fail_fast:
                        return rc
                continue

            pairs = _discover_idh_pairs(args.input_dir)
            if not pairs:
                print("[skip] task=idh no paired files found (expected *_t2f.nii.gz and *_t1ce.nii.gz)")
                continue
            for nifti_t2f, nifti_t1ce in pairs:
                rc = _run_idh_dual_task(nifti_t2f, nifti_t1ce, args.output_dir, args)
                if rc != 0:
                    failures += 1
                    if args.fail_fast:
                        return rc
            continue

        for nifti in all_inputs:
            rc = _run_single_task(task, nifti, args.output_dir, args)
            if rc != 0:
                failures += 1
                if args.fail_fast:
                    return rc
    _collect_quantitative_outputs(args.output_dir)
    return 0 if failures == 0 else 2


def cmd_submit_models(args: argparse.Namespace) -> int:
    tasks = _resolve_tasks(args.tasks)
    if args.input_dir is None:
        raise SystemExit("submit-models requires --input-dir")
    if not args.input_dir.exists():
        raise SystemExit(f"Input dir not found: {args.input_dir}")
    args.output_dir.mkdir(parents=True, exist_ok=True)
    args.logs_dir.mkdir(parents=True, exist_ok=True)

    submitted = 0
    fvar = '"$f"'
    for task in tasks:
        ckpt = _task_ckpt(task, args)
        ok, reason = _validate_task_checkpoint(task, ckpt)
        if not ok:
            print(f"[skip] task={task} {reason}")
            continue
        if task == "idh":
            print("[skip] task=idh submit-models is disabled until paired-input SLURM wrapping is configured")
            continue
        job_name = f"{args.job_prefix}_{task}"
        sbatch = [
            "sbatch",
            "--job-name",
            job_name,
            "--output",
            str(args.logs_dir / "%x_%j.out"),
            "--error",
            str(args.logs_dir / "%x_%j.err"),
            "--time",
            args.time,
            "--cpus-per-task",
            str(args.cpus),
            "--mem",
            args.mem,
        ]
        _append_optional(sbatch, "--partition", args.partition)
        _append_optional(sbatch, "--account", args.account)
        _append_optional(sbatch, "--qos", args.qos)
        _append_optional(sbatch, "--gres", args.gres)
        _append_optional(sbatch, "--constraint", args.constraint)
        _append_optional(sbatch, "--chdir", args.chdir)

        if task == "segmentation":
            inner = (
                "shopt -s globstar nullglob; "
                f"for f in {str(args.input_dir / '**' / '*.nii.gz')}; do "
                f"{_shell_join_allow_vars([sys.executable, str(SEG_SCRIPT), '--checkpoint_path', str(ckpt), '--simclr_checkpoint_path', str(args.simclr_checkpoint_path), '--image_path', fvar, '--output_dir', str(args.output_dir / 'segmentation'), '--gpu_device', args.gpu_device])}; "
                "done"
            )
        elif task == "brainage":
            inner = (
                "shopt -s globstar nullglob; "
                f"for f in {str(args.input_dir / '**' / '*_T1w.nii.gz')}; do "
                f"{_shell_join_allow_vars([sys.executable, str(TASK_SCRIPT[task]), '--nifti_path', fvar, '--checkpoint_path', str(ckpt), '--config_path', str(args.config_path), '--output_dir', str(args.output_dir / task), '--simclr_checkpoint_path', str(args.simclr_checkpoint_path), '--layer', str(args.layer), '--img_size', str(args.img_size[0]), str(args.img_size[1]), str(args.img_size[2]), '--patch_size', str(args.patch_size)])}; "
                "done"
            )
        else:
            script = TASK_SCRIPT[task]
            inner = (
                "shopt -s globstar nullglob; "
                f"for f in {str(args.input_dir / '**' / '*.nii.gz')}; do "
                f"{_shell_join_allow_vars([sys.executable, str(script), '--nifti_path', fvar, '--checkpoint_path', str(ckpt), '--config_path', str(args.config_path), '--output_dir', str(args.output_dir / task), '--simclr_checkpoint_path', str(args.simclr_checkpoint_path), '--layer', str(args.layer), '--img_size', str(args.img_size[0]), str(args.img_size[1]), str(args.img_size[2]), '--patch_size', str(args.patch_size)])}; "
                "done"
            )
        sbatch += ["--wrap", f"bash -lc {shlex.quote(inner)}"]
        print("$ " + _shell_join(sbatch))
        if not args.dry_run:
            subprocess.run(sbatch, check=False)
        submitted += 1
    return 0 if submitted > 0 else 2


def _add_models_common_args(parser: argparse.ArgumentParser) -> None:
    src_models = parser.add_mutually_exclusive_group(required=True)
    src_models.add_argument("--input", type=Path)
    src_models.add_argument("--input-dir", type=Path)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--checkpoint-map", type=str, default=None, help="task=/path/file.ckpt comma-separated")
    parser.add_argument("--config-path", type=Path, default=DEFAULT_CONFIG)
    parser.add_argument("--simclr-checkpoint-path", type=Path, default=DEFAULT_SIMCLR_CKPT)
    parser.add_argument("--gpu-device", type=str, default="cpu")
    parser.add_argument("--layer", type=int, default=-1)
    parser.add_argument("--img-size", nargs=3, type=int, default=(96, 96, 96))
    parser.add_argument("--patch-size", type=int, default=16)
    parser.add_argument("--fail-fast", action="store_true")


def cmd_single_task_alias(args: argparse.Namespace) -> int:
    # Map command alias to internal task name and forward to models runner.
    alias_to_task = {
        "age": "brainage",
        "brainage": "brainage",
        "idh": "idh",
        "mci": "mci",
        "stroke": "stroke",
        "sequence": "sequence",
        "survival": "survival",
        "seg": "segmentation",
    }
    task = alias_to_task.get(args.command, args.command)
    args.tasks = task
    return cmd_models(args)


def cmd_run_tasks(args: argparse.Namespace) -> int:
    args.tasks = ",".join(args.task_names)
    return cmd_models(args)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="brain", description="Brain pipeline top-level CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run", help="Run inference locally (single or batch)")
