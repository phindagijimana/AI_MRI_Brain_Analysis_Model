SAL_IDH = ROOT / "BrainIAC_upstream" / "src" / "generate_idh_vit_saliency.py"
SAL_MCI_STROKE = ROOT / "BrainIAC_upstream" / "src" / "generate_mci_stroke_vit_saliency.py"
SAL_SEQUENCE = ROOT / "BrainIAC_upstream" / "src" / "generate_multiclass_vit_saliency.py"
SAL_SURVIVAL = ROOT / "BrainIAC_upstream" / "src" / "generate_os_vit_saliency.py"
