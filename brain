    submit_models.add_argument("--job-prefix", type=str, default="brain_task")
    submit_models.add_argument("--partition", type=str, default=None)
    submit_models.add_argument("--account", type=str, default=None)
    submit_models.add_argument("--qos", type=str, default=None)
    submit_models.add_argument("--time", type=str, default="02:00:00")
    submit_models.add_argument("--cpus", type=int, default=4)
