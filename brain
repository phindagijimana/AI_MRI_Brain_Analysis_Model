def main() -> None:
    if not RUN_SCRIPT.exists():
        raise SystemExit(f"Missing required script: {RUN_SCRIPT}")
    if not SUBMIT_SCRIPT.exists():
        raise SystemExit(f"Missing required script: {SUBMIT_SCRIPT}")

    parser = build_parser()
    args = parser.parse_args()
    rc = args.func(args)
    raise SystemExit(rc)


if __name__ == "__main__":
    main()
