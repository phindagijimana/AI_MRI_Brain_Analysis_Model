    run.add_argument("--output-dir", type=Path, required=True)
    run.add_argument("--model-path", type=Path, default=None)
    run.add_argument("--model-meta", type=Path, default=None)
    run.add_argument("--task", choices=["auto", "segmentation", "classification", "regression"], default="auto")
    run.add_argument("--sequence", choices=["unknown", "T1", "T2", "FLAIR", "T1CE"], default="unknown")
    run.add_argument("--target-spacing", type=float, default=1.0)
    run.add_argument("--target-shape", type=int, nargs=3, default=(96, 96, 96), metavar=("D", "H", "W"))
